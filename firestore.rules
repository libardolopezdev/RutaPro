rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Acceso cerrado por defecto para cualquier documento no especificado
    match /{document=**} {
      allow read, write: if false;
    }

    // El usuario solo puede acceder a su propio documento de perfil base
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // El usuario solo puede acceder a subcolecciones que le pertenecen (jornada_activa, historico, settings, etc.)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
